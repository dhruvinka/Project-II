<!DOCTYPE html>
<html>
<head>
    <title>Students</title>
</head>
<body>

<h2>Student List</h2>

<a href="/add">Add Student</a>

<table border="1">
<tr>
    <th>ID</th>
    <th>Name</th>
    <th>Email</th>
    <th>Actions</th>
</tr>

<% students.forEach(s => { %>
<tr>
    <td><%= s.id %></td>
    <td><%= s.name %></td>
    <td><%= s.email %></td>
    <td>
        <a href="/edit/<%= s.id %>">Edit</a>
        <a href="/delete/<%= s.id %>">Delete</a>
    </td>
</tr>
<% }) %>

</table>

</body>
</html>