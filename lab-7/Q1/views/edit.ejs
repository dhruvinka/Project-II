<!DOCTYPE html>
<html>
<head>
    <title>Edit Student</title>
</head>
<body>

<h2>Edit Student</h2>

<form action="/edit/<%= student.id %>" method="POST">
    <input type="text" name="name" value="<%= student.name %>"><br><br>
    <input type="email" name="email" value="<%= student.email %>"><br><br>
    <button type="submit">Update</button>
</form>

<a href="/">Back</a>

</body>
</html>